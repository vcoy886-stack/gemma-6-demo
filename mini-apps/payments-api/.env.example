# Copia este archivo a ".env" para desarrollo local (vercel dev) y NUNCA lo subas al repo.
# En producción, configura estas mismas variables en Vercel: Project -> Settings -> Environment Variables.

# Dashboard de Wompi -> Desarrolladores -> "Secretos para integración técnica"
# Empieza en modo SANDBOX/PRUEBAS (prod_test_... o test_integrity_...) hasta completar
# el checklist de producción del README antes de usar las llaves reales.
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZA_CON_TU_SECRETO_DE_PRUEBAS
WOMPI_EVENTS_SECRET=test_events_REEMPLAZA_CON_TU_SECRETO_DE_EVENTOS
