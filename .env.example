# Base de datos (SQLite local, archivo real y persistente).
# En producción cambia a una URL de PostgreSQL sin tocar código: postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# Clave secreta para firmar los tokens de sesión (JWT). Genera una propia en producción:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="genera-tu-propia-clave-aleatoria-larga-aqui"

# Opcional: habilita el Asistente IA generativo (respuestas en lenguaje natural, mensajes
# sugeridos por Claude). Sin esta clave, el asistente sigue funcionando en modo determinista
# (consultas reales a la base de datos) pero sin generación de lenguaje libre.
# Consigue una key en https://console.anthropic.com/
ANTHROPIC_API_KEY=""
